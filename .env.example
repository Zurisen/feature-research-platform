# Copy to .env.local. Everything here is optional for a first local run.

# Only needed when Settings > Agent authentication is "API key".
# Leave unset to use the Claude Code login on this machine.
ANTHROPIC_API_KEY=

# Apollo.io OAuth app (Apollo > Settings > Integrations > API Keys > OAuth registration).
# The redirect URI must be https and match the registration exactly,
# e.g. https://<tunnel-host>/api/apollo/callback
APOLLO_CLIENT_ID=
APOLLO_CLIENT_SECRET=
APOLLO_REDIRECT_URI=
# APOLLO_SCOPES=read_user_profile app_scopes organizations_enrich contacts_search

# Development fallback while the OAuth app awaits approval from Apollo.
APOLLO_API_KEY=

# Optional: path to a native claude.exe if the bundled SDK binary is unavailable.
# CLAUDE_CODE_PATH=
